    {
      "id": 9,
      "title": "Identificação declarada pelo User-Agent",
      "type": "timeseries",
      "description": "Declaração, sem autenticação do provedor. Clientes sintéticos também podem copiar esses headers.",
      "datasource": {
        "type": "prometheus",
